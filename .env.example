# Copy to .env for a custom installation. run.cmd creates a local demo password on first use.
HOST=127.0.0.1
PORT=4310
# Browser Healthcheck defaults to installed Chrome on Windows and Playwright Chromium on Linux.
HEALTHCHECK_BROWSER_CHANNEL=
DATA_DIR=./data
DEMO_ADMIN_EMAIL=admin@releasegate.local
DEMO_ADMIN_PASSWORD=

# Optional inbound report integration. Leave blank to use authenticated local intake only.
DF9_INTAKE_KEY=
DF9_INTAKE_KEYS=
RELEASEGATE_BASE_URL=
# Optional stable external request ID for repeatable local sender demonstrations.
DF9_DEMO_REQUEST_ID=

# An optional model stops at the proposal stage.
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=

# Set the public HTTPS origin when running behind a reverse proxy.
PUBLIC_ORIGIN=
LLM_TIMEOUT_MS=30000
